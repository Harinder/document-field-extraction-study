# Copy to .env and adjust. .env is gitignored and must stay that way.

# Local Ollama, which is what every number in this repo was produced with.
BASE_URL=http://localhost:11434/v1
MODEL=qwen3-14b-32k

# Only first_call.py uses the OpenAI client, and the client will not start
# without a key. Ollama ignores the value, so any placeholder works locally.
# Use a real key only if you point BASE_URL at a hosted provider.
OPENAI_API_KEY=placeholder

# Number of documents first_call.py reads.
# N_DOCS=5
